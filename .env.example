# Required. Use the same broker/vhost and databases as the TypeScript service.
# These are local examples, not production credentials.
RABBIT_MQ=amqp://guest:guest@localhost:5672/%2f
MONGO_PATH=mongodb://localhost:27017/satoshi_bot
TRADE_STATION_MONGO_PATH=mongodb://localhost:27017/trade_station
REDIS=localhost

# RabbitMQ: only this worker queue is supported; "all" is rejected.
CLIENT_TRADE_WORKER_QUEUES=satoshi-channel-updates.client-trade.bingx.futures
RABBITMQ_QUEUE=create-new-trusted-trade
CONSUMER_PREFETCH=2
RABBITMQ_RETRY_MAX_ATTEMPTS=5
RABBITMQ_RETRY_DELAY_MS=1000
RABBITMQ_RECONNECT_BASE_MS=500
RABBITMQ_RECONNECT_MAX_MS=30000
RABBITMQ_RECONNECT_JITTER_RATIO=0.2

# Redis host and port are separate, as in TypeScript.
REDIS_CLIENT_PORT=6379
REDIS_LOCK_CONNECT_TIMEOUT_MS=1000
REDIS_LOCK_COMMAND_TIMEOUT_MS=1000
REDIS_NOTIFICATION_CONNECT_TIMEOUT_MS=2000
REDIS_NOTIFICATION_COMMAND_TIMEOUT_MS=2000
REDIS_CACHE_CONNECT_TIMEOUT_MS=1000
REDIS_CACHE_COMMAND_TIMEOUT_MS=500
PROCESSING_LOCK_PREFIX=satoshi-channel-updates:locks:v1
EXCHANGE_METADATA_CACHE_PREFIX=satoshi-channel-updates:exchange-metadata:v1
EXCHANGE_METADATA_CACHE_TTL_MS=3600000

# Runtime settings consumed by later lifecycle stages.
STARTUP_RETRY_DELAY_MS=5000
STARTUP_RETRY_MAX_DELAY_MS=30000
STARTUP_RETRY_JITTER_RATIO=0.2
RUNTIME_OPERATION_TIMEOUT_MS=10000
SHUTDOWN_DRAIN_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=30000
SERVICE_REVISION=channels-manager-v1
